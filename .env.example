# Hermes self-evolution LLM config template.
# Copy to .env and fill in OPENAI_API_KEY. .env itself is gitignored.
# Sourced by nightly.sh, run_evolution.sh, smoke_test.sh with `set -a` so
# every variable exports to child processes (Python, pytest, etc.).

export OPENAI_API_BASE="http://localhost:20128/v1"
export OPENAI_BASE_URL="http://localhost:20128/v1"
export OPENAI_API_KEY="***"

# ── Model split ─────────────────────────────────────────────────────────────
# codex-spark = optimizer / proposer / reflection / task
# gpt-5.4     = judge / eval ONLY
export MODEL="openai/cx/gpt-5.3-codex-spark"
export TASK_MODEL="openai/cx/gpt-5.3-codex-spark"
export EVOLUTION_TASK_MODEL="openai/cx/gpt-5.3-codex-spark"

export EVOLUTION_OPTIMIZER_MODEL="openai/cx/gpt-5.3-codex-spark"
export EVOLUTION_PROMPT_MODEL="openai/cx/gpt-5.3-codex-spark"
export EVOLUTION_REFLECTION_MODEL="openai/cx/gpt-5.3-codex-spark"

export EVOLUTION_EVAL_MODEL="openai/cx/gpt-5.4"
export EVOLUTION_JUDGE_MODEL="openai/cx/gpt-5.4"

# ── Optimizer policy ────────────────────────────────────────────────────────
# Production optimizer = MIPROv2. GEPA stays manual/debug-only.
export OPTIMIZER="mipro"
export EVOLUTION_MIPRO_AUTO="manual"

# ── Fitness / holdout ───────────────────────────────────────────────────────
export EVOLUTION_FITNESS_MODE="fast"
export EVOLUTION_HOLDOUT_METRIC="judge"

# ── Reliability knobs ───────────────────────────────────────────────────────
# Retries=0 to surface hangs as hangs (no silent retry masking).
export EVOLUTION_LM_NUM_RETRIES="0"
# Faulthandler dumps thread traceback this many seconds before SIGALRM fires.
export OPTIMIZER_TRACEBACK_MARGIN="15"

# ── Role-specific LM config (A-prime) ───────────────────────────────────────
# Task role = baseline/evolved skill rollouts (fast, low-stake).
# Retries=1 to self-heal transient 429 bursts from codex-spark; phase
# timeout still bounds blast radius.
export EVOLUTION_TASK_TIMEOUT="120"
export EVOLUTION_TASK_RETRIES="1"
export EVOLUTION_TASK_MAX_TOKENS="2048"

export EVOLUTION_OPTIMIZER_TIMEOUT="120"
export EVOLUTION_OPTIMIZER_RETRIES="0"
export EVOLUTION_OPTIMIZER_MAX_TOKENS="2048"

export EVOLUTION_JUDGE_TIMEOUT="360"
export EVOLUTION_JUDGE_RETRIES="0"
export EVOLUTION_JUDGE_MAX_TOKENS="1024"
export EVOLUTION_JUDGE_NUM_THREADS="1"
export EVOLUTION_JUDGE_PHASE_TIMEOUT="900"

# ── Autopilot + auto-merge gates ────────────────────────────────────────────
# Autopilot target exclusions — extend the built-in self-evolution denylist.
export EVOLUTION_EXCLUDE_SKILLS=""
# Manual override to evolve the engine itself (Batch A hard-block escape).
export EVOLUTION_ALLOW_SELF_TARGET="0"

# Auto-merge floor: fixed 0.05 delta during Day 0-7 rollout.
# If EVOLUTION_JUDGE_SIGMA_OVERRIDE is set, effective floor becomes
# max(EVOLUTION_MIN_AUTO_DELTA, 2 * sigma). Leave blank until calibration runs.
export EVOLUTION_MIN_AUTO_DELTA="0.05"
export EVOLUTION_JUDGE_SIGMA_OVERRIDE=""
