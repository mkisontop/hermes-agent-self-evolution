# nightly evolution + digest — install to /etc/systemd/system/
[Unit]
Description=polyarb nightly: journal-replay evolution + report
After=polyarb.service
OnFailure=polyarb-alert@%n.service

[Service]
Type=oneshot
User=polyarb
Group=polyarb
WorkingDirectory=/opt/polyarb/repo
# load NTFY_TOPIC / POLYARB_NIGHTLY_HC / paths so the digest and the
# healthchecks dead-man ping actually fire
EnvironmentFile=-/etc/polyarb/env
Environment=PYTHONUNBUFFERED=1 PYTHONPATH=/opt/polyarb/repo
TimeoutStartSec=30min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=polyarb
LogsDirectory=polyarb
