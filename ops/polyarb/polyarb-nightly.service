# nightly evolution + digest — install to /etc/systemd/system/
[Unit]
Description=polyarb nightly: journal-replay evolution + report
After=polyarb.service
OnFailure=polyarb-alert@%n.service

[Service]
Type=oneshot
User=polyarb
Group=polyarb
WorkingDirectory=/opt/polyarb
ExecStart=/opt/polyarb/repo/ops/polyarb/nightly.sh
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=30min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=polyarb
LogsDirectory=polyarb
